{
  "name": "litigator",
  "displayName": "Litigator",
  "version": "0.25.0",
  "description": "Court work on a matter, for British Columbia lawyers: applying the law to the facts, drafting, court forms, filing packages and calculations. Requires the lawyer and researcher plugins: install lawyer, then researcher, then litigator.",
  "author": {
    "name": "Probanda Legal",
    "url": "https://github.com/Probanda-app"
  },
  "homepage": "https://github.com/Probanda-app/Legal",
  "repository": "https://github.com/Probanda-app/Legal",
  "dependencies": [
    {
      "name": "lawyer",
      "marketplace": "Probanda_Legal_experimental",
      "version": "^0.29.0"
    },
    {
      "name": "researcher",
      "marketplace": "Probanda_Legal_experimental",
      "version": "^0.19.0"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.+drafting_data__record_(sent|filed|served)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/one-way-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "One-way approval gate"
          }
        ]
      },
      {
        "matcher": "mcp__(.+__)?plugin_lawyer_data__(drafting_data__(execute|set_board_goal|merge_milestones|merge_jobs|assign_job)|drafting_forms__apply_edit)",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/drafting-data/hooks/practitioner-words-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "Practitioner-words gate"
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookRead|NotebookEdit|Grep|Bash|PowerShell|mcp__(.+__)?device_.*|mcp__(.+__)?workspace__bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/drafting-data/hooks/html-pages-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "HTML pages gate"
          }
        ]
      },
      {
        "matcher": "mcp__(.+__)?plugin_lawyer_data__drafting_forms__draft_harness|mcp__(.+__)?plugin_lawyer_contacts-calendars-email__mail__save_draft|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/correspondence-review-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "Correspondence review gate"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/correspondence-note.py"
            ],
            "timeout": 10,
            "statusMessage": "Correspondence note"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__(.+__)?plugin_lawyer_data__(drafting_forms__(open_session|render)|drafting_data__(complete_job|attach_to_board))",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/drafting-data/hooks/milestone-card-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "Work Board card gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/drafting-data/hooks/milestone-card-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "Work Board card gate"
          }
        ]
      }
    ]
  }
}
