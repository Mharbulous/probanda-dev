{
  "name": "legal",
  "displayName": "Probanda Legal",
  "version": "0.6.0",
  "description": "The core Probanda plugin for British Columbia lawyers: firm records, time, billing, case data and deadlines. Install it first. The research, litigator, solicitor, file-manager and timekeeper plugins all require it. The lawyer plugin does not require it.",
  "author": {
    "name": "Probanda",
    "url": "https://github.com/Probanda-app"
  },
  "homepage": "https://github.com/Probanda-app/Probanda",
  "repository": "https://github.com/Probanda-app/Probanda",
  "mcpServers": "./.mcp.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__(.+__)?device_bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/safe-file-deletion/hooks/redirect-delete-to-trash.py"
            ],
            "timeout": 10,
            "statusMessage": "Soft-delete guard"
          }
        ]
      },
      {
        "matcher": "Skill|mcp__(.+__)?plugin_legal_data__practice_data__(active_deadlines|open_tasks|upsert_deadline|upsert_anchor|delete_anchor|rule_overlay|upsert_rule_overlay|render_practice_board)|mcp__(.+__)?plugin_legal_data__rules__audit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/shared/docket-clerk/hooks/session-lane-guard.py"
            ],
            "timeout": 10,
            "statusMessage": "Drafting/deadline session guard"
          }
        ]
      },
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/show-me/hooks/staged-file-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "Staged-file gate"
          }
        ]
      },
      {
        "matcher": "mcp__.+mail_(send_email|forward_email|reply_to_email)",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/mail-send-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "Mail-send gate"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/plugin-cache-guard.py"
            ],
            "timeout": 10,
            "statusMessage": "Installed-plugin guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/practice-data/hooks/inject-practice-quirks.py"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/hidden-skills-note.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/shared/docket-clerk/hooks/session-lane-guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "legal:docket-clerk",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/shared/docket-clerk/hooks/session-lane-guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "legal:docket-clerk",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/shared/docket-clerk/hooks/session-lane-guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
