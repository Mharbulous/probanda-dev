{
  "name": "research",
  "displayName": "Probanda Research",
  "version": "0.2.5",
  "description": "What the law is, for British Columbia lawyers: legal research, citation and verification against audited authorities. Requires the practice plugin: install practice first, then research.",
  "author": {
    "name": "Probanda",
    "url": "https://github.com/Probanda-app"
  },
  "homepage": "https://github.com/Probanda-app/Probanda-Legal",
  "repository": "https://github.com/Probanda-app/Probanda-Legal",
  "dependencies": [
    "practice"
  ],
  "mcpServers": "./.mcp.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(.+__)?plugin_research_canlii__.+",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/legal-research/hooks/block-main-session-canlii.py"
            ],
            "timeout": 10,
            "statusMessage": "Closed-gate guard"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/legal-research/hooks/block-subagent-legal-research.py"
            ],
            "timeout": 10,
            "statusMessage": "Research gate main-session guard"
          }
        ]
      },
      {
        "matcher": "mcp__(.+__)?plugin_research_commons__legal_commons__(push|amend_authority|amend_authority_edge|amend_criterion_text|amend_principle_text|link_authority|unlink_authority|merge_authority|record_treatment|stamp_verified|rule_period_push|rule_period_record_verification|rule_period_retire)",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/commons-read-only.py"
            ],
            "timeout": 10,
            "statusMessage": "Commons read-only guard"
          }
        ]
      }
    ]
  }
}
