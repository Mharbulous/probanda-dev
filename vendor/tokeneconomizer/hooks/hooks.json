{
  "description": "TokenEconomizer: inject learned repo facts at session start, guard prompt-turns against failing loops, and fold each finished session into what is learned.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 20
          },
          {
            "type": "mcp_tool",
            "server": "plugin:lawyer:data",
            "tool": "practice_data__config_status",
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "remote-devices",
            "tool": "plugin_lawyer_data__practice_data__config_status",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
