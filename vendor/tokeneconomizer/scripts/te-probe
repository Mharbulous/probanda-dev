#!/bin/sh
# Temporary Cowork spike-test probe (S2). Acts only in a Cowork container, whose working
# folder is /home/claude; anywhere else it answers "no change".
dir=$(CDPATH= cd -- "${0%/*}" && pwd)
if [ "$PWD" = /home/claude ] && command -v python3 >/dev/null 2>&1; then
  exec python3 "$dir/te_probe.py"
fi
while IFS= read -r _line; do :; done
echo '{}'
