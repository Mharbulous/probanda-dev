{
  "permissions": {
    "deny": [
      "Edit(/COMMANDMENTS.md)",
      "Edit(/CLAUDE.md)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-commandments.js"],
            "timeout": 15,
            "statusMessage": "Loading COMMANDMENTS.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commandments.js"],
            "timeout": 15,
            "statusMessage": "COMMANDMENTS.md shell guard"
          }
        ]
      }
    ]
  }
}
