{
  "env": {
    "COCLERK_HTML_DEV": "1"
  },
  "permissions": {
    "deny": [
      "Edit(/COMMANDMENTS.md)",
      "mcp__c2e0eec9-3d82-4a9f-a49f-d44e1f7a126c"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-commandments.js"
            ],
            "timeout": 15,
            "statusMessage": "Loading COMMANDMENTS.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commandments.js"
            ],
            "timeout": 15,
            "statusMessage": "COMMANDMENTS.md shell guard"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/exception-rulings-guard.js"
            ],
            "timeout": 15,
            "statusMessage": "Exception rulings guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/exception-rulings-guard.js"
            ],
            "timeout": 15,
            "statusMessage": "Exception rulings guard"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-regression-suite.py"
            ],
            "timeout": 10,
            "statusMessage": "No regression suite guard"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "alcbar-ai-risk-check@synced": false,
    "bc-trust-accounting@synced": false,
    "bcn-monitor@synced": false,
    "budget-and-fee-manager@synced": false,
    "closing-trust-accounts@synced": false,
    "commandments@synced": false,
    "cowork-plugin-management@synced": false,
    "firebase-genai@synced": false,
    "firebase-genai@toolkit": false,
    "legal-builder-hub@synced": false,
    "matter-intake-scoping@synced": false,
    "matter-plan-builder@synced": false,
    "nvidia-skills@synced": false,
    "reflect@synced": false,
    "shortform-notes@synced": false,
    "supabase-expert@synced": false,
    "timekeeper@synced": false,
    "timeline-generator@synced": false,
    "trials@synced": false,
    "ultrapowers-dev@synced": false
  }
}
