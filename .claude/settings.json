{
  "env": {
    "COCLERK_HTML_DEV": "1"
  },
  "permissions": {
    "deny": [
      "Edit(/COMMANDMENTS.md)"
    ]
  },
  "hooks": {
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-commandments.js"],
            "timeout": 15,
            "statusMessage": "Loading COMMANDMENTS.md"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commandments.js"],
            "timeout": 15,
            "statusMessage": "COMMANDMENTS.md shell guard"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/public-repo-guard.js"],
            "timeout": 15,
            "statusMessage": "Public repository guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/public-repo-guard.js"],
            "timeout": 15,
            "statusMessage": "Public repository guard"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/public-folder-scan.js"],
            "timeout": 30,
            "statusMessage": "Public folder scan"
          }
        ]
      }
    ]
  }
}
