{
  "name": "developer",
  "displayName": "Developer",
  "version": "0.11.1",
  "description": "Maintainer-only Probanda plugin for developing Probanda: viewing and triaging the Suggestion Box. It is never public, and its skills run only in a Claude Code session opened in the probanda-dev checkout. Requires the lawyer plugin: install lawyer first.",
  "author": {
    "name": "Probanda Legal",
    "url": "https://github.com/Probanda-app"
  },
  "homepage": "https://github.com/Probanda-app/Legal",
  "repository": "https://github.com/Probanda-app/Legal",
  "dependencies": [
    {
      "name": "lawyer",
      "marketplace": "Probanda_Legal_experimental",
      "version": "^0.29.4"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.+skill_source__read$",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/payload-probe.py"
            ],
            "timeout": 10,
            "statusMessage": "Payload probe"
          }
        ]
      }
    ]
  }
}
