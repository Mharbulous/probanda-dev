{
  "name": "probanda",
  "displayName": "Probanda",
  "version": "0.1.0",
  "description": "A litigation practice plugin for British Columbia lawyers: matters, billing, deadlines, court forms, case analysis and legal research.",
  "author": {
    "name": "Mharbulous",
    "url": "https://github.com/Mharbulous"
  },
  "homepage": "https://github.com/Mharbulous/probanda",
  "repository": "https://github.com/Mharbulous/probanda",
  "mcpServers": "./.mcp.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__(.+__)?device_bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/safe-file-deletion/hooks/redirect-delete-to-trash.py"
            ],
            "timeout": 10,
            "statusMessage": "Soft-delete guard"
          }
        ]
      },
      {
        "matcher": "mcp__(.+__)?plugin_probanda_canlii__.+",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/legal-research/hooks/block-main-session-canlii.py"
            ],
            "timeout": 10,
            "statusMessage": "Closed-gate guard"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/legal-research/hooks/block-subagent-legal-research.py"
            ],
            "timeout": 10,
            "statusMessage": "Research gate main-session guard"
          }
        ]
      },
      {
        "matcher": "Skill|mcp__(.+__)?plugin_probanda_data__practice_data__(active_deadlines|open_tasks|upsert_deadline|upsert_anchor|delete_anchor|rule_overlay|upsert_rule_overlay)|mcp__(.+__)?plugin_probanda_data__rules__audit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/shared/docket-clerk/hooks/session-lane-guard.py"
            ],
            "timeout": 10,
            "statusMessage": "Drafting/deadline session guard"
          }
        ]
      },
      {
        "matcher": "mcp__(.+__)?plugin_probanda_data__drafting_data__execute",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/drafting-data/hooks/practitioner-words-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "Practitioner-words gate"
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookRead|NotebookEdit|Grep|Bash|PowerShell|mcp__(.+__)?device_.*|mcp__(.+__)?workspace__bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/drafting-data/hooks/html-pages-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "HTML pages gate"
          }
        ]
      },
      {
        "matcher": "SendUserFile",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/show-me/hooks/staged-file-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "Staged-file gate"
          }
        ]
      },
      {
        "matcher": "mcp__.+mail_(send_email|forward_email|reply_to_email)",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/draft/hooks/mail-send-gate.py"
            ],
            "timeout": 10,
            "statusMessage": "Mail-send gate"
          }
        ]
      },
      {
        "matcher": "mcp__(.+__)?plugin_probanda_commons__legal_commons__(push|amend_authority|amend_authority_edge|amend_criterion_text|amend_principle_text|link_authority|unlink_authority|merge_authority|record_treatment|stamp_verified|rule_period_push|rule_period_record_verification|rule_period_retire)",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/commons-read-only.py"
            ],
            "timeout": 10,
            "statusMessage": "Commons read-only guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/practice-data/hooks/inject-practice-quirks.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/shared/docket-clerk/hooks/session-lane-guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "probanda:docket-clerk",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/shared/docket-clerk/hooks/session-lane-guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "probanda:docket-clerk",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/shared/docket-clerk/hooks/session-lane-guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
