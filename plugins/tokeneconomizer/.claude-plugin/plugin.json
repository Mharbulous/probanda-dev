{
  "name": "tokeneconomizer",
  "displayName": "TokenEconomizer",
  "version": "0.2.9",
  "description": "Experience-driven black-box cost control for coding agents, adapted for Claude Code and Claude Cowork: micro-skills (short repository facts learned from earlier sessions) injected at session start, and a guard that redirects a turn stuck in a failing loop. Tool pruning is off in this copy.",
  "author": {
    "name": "TokenEconomizer authors"
  },
  "repository": "https://github.com/microsoft/TokenEconomizer",
  "license": "Apache-2.0",
  "commands": "./slash-commands/",
  "keywords": [
    "cost",
    "tokens",
    "context",
    "hooks",
    "micro-skills",
    "failure-loops"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TE_LOOPGUARD_THRESHOLDS='{\"envelope_frozen\":38}' TE_TOOLPRUNE=off \"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TE_LOOPGUARD_THRESHOLDS='{\"envelope_frozen\":38}' TE_TOOLPRUNE=off \"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/te-p1\"",
            "timeout": 30
          },
          {
            "type": "mcp_tool",
            "server": "plugin:tokeneconomizer:state",
            "tool": "probe_hit",
            "timeout": 10,
            "input": {
              "form": "plugin-scoped",
              "event": "${hook_event_name}",
              "session": "${session_id}",
              "cwd": "${cwd}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "remote-devices",
            "tool": "plugin_tokeneconomizer_state__probe_hit",
            "timeout": 10,
            "input": {
              "form": "remote-devices",
              "event": "${hook_event_name}",
              "session": "${session_id}",
              "cwd": "${cwd}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "remote-devices",
            "tool": "device_bash",
            "timeout": 10,
            "input": {
              "command": "mkdir -p ~/mnt/te-cowork-test/te-runs/p1 && echo \"$(date -u +%FT%TZ) ${hook_event_name} ${session_id}\" >> ~/mnt/te-cowork-test/te-runs/p1/device-bash.txt"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TE_LOOPGUARD_THRESHOLDS='{\"envelope_frozen\":38}' TE_TOOLPRUNE=off \"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TE_LOOPGUARD_THRESHOLDS='{\"envelope_frozen\":38}' TE_TOOLPRUNE=off \"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TE_LOOPGUARD_THRESHOLDS='{\"envelope_frozen\":38}' TE_TOOLPRUNE=off \"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:tokeneconomizer:state",
            "tool": "probe_hit",
            "timeout": 10,
            "input": {
              "form": "plugin-scoped",
              "event": "${hook_event_name}",
              "session": "${session_id}",
              "cwd": "${cwd}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "remote-devices",
            "tool": "plugin_tokeneconomizer_state__probe_hit",
            "timeout": 10,
            "input": {
              "form": "remote-devices",
              "event": "${hook_event_name}",
              "session": "${session_id}",
              "cwd": "${cwd}"
            }
          },
          {
            "type": "mcp_tool",
            "server": "remote-devices",
            "tool": "device_bash",
            "timeout": 10,
            "input": {
              "command": "mkdir -p ~/mnt/te-cowork-test/te-runs/p1 && echo \"$(date -u +%FT%TZ) ${hook_event_name} ${session_id}\" >> ~/mnt/te-cowork-test/te-runs/p1/device-bash.txt"
            }
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "TE_LOOPGUARD_THRESHOLDS='{\"envelope_frozen\":38}' TE_TOOLPRUNE=off \"${CLAUDE_PLUGIN_ROOT}/scripts/te-hook\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
