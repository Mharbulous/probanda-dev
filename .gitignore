# OS junk
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Dependencies
node_modules/

# TypeScript output of the MCP runtimes (the bundles in dist/ are tracked)
source/*/*/build/

# Python caches
__pycache__/
.pytest_cache/

# Secrets and local data
.env*
*.db
*.sqlite*

# Built plugin archives
*.plugin

# Soft-deleted files (the delete guard moves them here)
TRASH/

# Folders build_plugin.py holds only while a build runs
plugins/.*.building/
plugins/.*.replaced/

# Session worktrees
.claude/worktrees/

# Editors
.vscode/
.idea/
*.swp
supabase/.temp/
